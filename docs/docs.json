{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Forme",
  "theme": "mint",
  "logo": {
    "light": "/wordmark.svg",
    "dark": "/wordmark-white.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#111827"
  },
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "https://github.com/formepdf/forme"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "quickstart",
          "html",
          "svelte",
          "vue",
          "preact",
          "template-gallery",
          "vscode",
          "faq"
        ]
      },
      {
        "group": "Template Library",
        "pages": [
          "templates",
          {
            "group": "Billing & Finance",
            "pages": [
              "templates/invoice-standard",
              "templates/invoice-detailed",
              "templates/credit-note",
              "templates/receipt",
              "templates/quote",
              "templates/statement",
              "templates/purchase-order",
              "templates/remittance-advice",
              "templates/expense-report",
              "templates/payslip"
            ]
          },
          {
            "group": "Correspondence & Legal",
            "pages": [
              "templates/letterhead",
              "templates/cover-letter",
              "templates/memo",
              "templates/employment-contract",
              "templates/nda",
              "templates/service-agreement",
              "templates/offer-letter",
              "templates/termination-letter",
              "templates/reference-letter",
              "templates/policy-acknowledgement"
            ]
          },
          {
            "group": "Reports, Logistics & Certificates",
            "pages": [
              "templates/report-annual",
              "templates/report-monthly",
              "templates/lab-report",
              "templates/inspection-report",
              "templates/shipping-label",
              "templates/packing-slip",
              "templates/delivery-note",
              "templates/certificate",
              "templates/product-catalog",
              "templates/meeting-minutes"
            ]
          }
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "components",
          "styles",
          "tailwind",
          "fonts",
          "page-breaks",
          "charts",
          "layout",
          "template-mode",
          "embedded-data",
          "self-hosting"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/render",
          "api-reference/certify",
          "api-reference/redact",
          "api-reference/merge"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/redaction",
          "concepts/digital-certification"
        ]
      },
      {
        "group": "Enterprise",
        "pages": [
          "forms",
          "accessibility",
          "archival",
          "einvoicing"
        ]
      },
      {
        "group": "SDKs",
        "pages": [
          "typescript-sdk",
          "python-sdk",
          "go-sdk",
          "rust-sdk"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/e-invoicing-with-a-pdp",
          "guides/migrating-to-0-9",
          "guides/bring-your-own-ui",
          "migrating-from-react-pdf",
          "replacing-puppeteer",
          "guides/migrating-from-wkhtmltopdf",
          "guides/migrating-from-dompdf"
        ]
      },
      {
        "group": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/api-reference",
      "destination": "/api-reference/render"
    },
    {
      "source": "/digital-signatures",
      "destination": "/concepts/digital-certification"
    },
    {
      "source": "/changelog/0-9-0",
      "destination": "/changelog"
    },
    {
      "source": "/changelog/0-8-3",
      "destination": "/changelog"
    }
  ]
}
