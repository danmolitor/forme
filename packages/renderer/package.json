{
  "name": "@formepdf/renderer",
  "version": "0.17.0",
  "description": "File-to-PDF rendering pipeline for Forme — bundles TSX, resolves assets, renders via WASM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": "./dist/preview/index.html"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/preview && cp -r src/preview dist/preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@formepdf/core": "0.17.0",
    "@formepdf/html": "0.17.0",
    "@formepdf/react": "0.17.0",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@formepdf/preact": "0.17.0",
    "@formepdf/svelte": "0.17.0",
    "@formepdf/vue": "0.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "preact": "^10.0.0",
    "react": "^19.0.0",
    "svelte": "^5.30.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "vue": "^3.4.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/formepdf/forme",
    "directory": "packages/renderer"
  }
}
